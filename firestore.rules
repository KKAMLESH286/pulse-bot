rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Users can only create messages with role "user"
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.role == 'user';
      }

      match /workouts/{workoutId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // Only Cloud Functions (admin SDK) can create/update workouts
      }

      // Legacy collection — kept for read access during migration
      match /workout_logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }

      match /prs/{prId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Only Cloud Functions (admin SDK) can write PRs
      }

      match /meal_plan/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /agent_config/{configId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
